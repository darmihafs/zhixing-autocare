# =====================================================================
# 洪兴洗车电商服务平台 - 环境变量示例模板（无真实密钥，可安全提交 Git）
# 使用方式：
#   cp .env.example .env       # Linux 部署（deploy/start-all.sh 自动加载 .env）
#   cp .env.example .env.local # Windows 本地演示（start-all.bat 加载 .env.local）
# =====================================================================

# ---- 网络绑定与 Nacos 注册 ----
# 单机 Linux / Nginx 反代部署建议保持业务服务绑定 127.0.0.1，由 Nginx -> 网关 8080 统一转发
SERVER_ADDRESS=127.0.0.1
NACOS_ADDR=127.0.0.1:8848
NACOS_DISCOVERY_IP=127.0.0.1
# Docker Compose 宿主机端口绑定地址（默认仅监听本机，防中间件裸露公网）
BIND_HOST=127.0.0.1

# ---- 数据库 MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USERNAME=root
# 上线前请替换为高强度密码，同步修改 docker-compose / MySQL 实例密码
MYSQL_PASSWORD=change-me-strong-mysql-password
MYSQL_USE_SSL=false

# ---- 缓存 Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# 上线前请替换为高强度密码
REDIS_PASSWORD=change-me-strong-redis-password

# ---- 消息队列与搜索引擎 ----
ROCKETMQ_NAMESRV=127.0.0.1:9876
ES_URIS=http://127.0.0.1:9200
NACOS_AUTH_ENABLE=false
ES_SECURITY_ENABLED=false

# ---- 安全密钥与服务间凭证（上线前务必替换为 >=32 位随机高强度字符串） ----
JWT_SECRET=change-me-at-least-32-chars-random-jwt-secret-key
INTERNAL_TOKEN=change-me-random-internal-service-token

# ---- 业务与演示功能开关 ----
# 生产上线务必设为 false，关闭模拟支付 (/pay/*/mock) 与买家演示发货 (/order/*/demo-deliver)
HC_DEMO_ENABLED=false
# 直连数据库压测接口 (/shop/db/{id}、/shop/service/db/{id})，生产保持 false
HC_PERF_ENABLED=false
# WebSocket 允许来源域名（生产建议设为实际域名，例如 https://shop.example.com）
HC_WS_ALLOWED_ORIGINS=*

# ---- 订单超时与文件上传 ----
# RocketMQ 延迟等级（16=30分钟，4=30秒）与前端倒计时秒数必须保持一致
ORDER_PAY_TIMEOUT_DELAY_LEVEL=16
ORDER_PAY_TIMEOUT_SECONDS=1800
# 评价图片持久化存储目录（生产建议使用绝对挂载路径，如 /data/hongcheng/uploads/review）
HC_UPLOAD_REVIEW_DIR=./uploads/review

# ---- AI 养车顾问（OpenAI 兼容接口）----
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 留空将自动降级为本地真实商品/门店检索，不会报错 500
AI_API_KEY=

# ---- Linux 启动脚本 JVM 资源调优参数（deploy/start-all.sh 使用） ----
# JVM_XMS=128m
# JVM_XMX=256m
# JVM_EXTRA_OPTS=-XX:MaxMetaspaceSize=96m -Xss256k -XX:+UseG1GC
